default_platform(:ios)

platform :ios do
  desc "Certificat Distribution + profil App Store CarenceScan (clé API, sans Mac local)"
  lane :bootstrap_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY"),
      is_key_content_base64: false
    )

    keychain_path = ENV.fetch("KEYCHAIN_PATH")
    keychain_password = ENV.fetch("KEYCHAIN_PASSWORD")
    profiles_path = ENV.fetch("PROFILES_PATH")
    certs_path = ENV.fetch("CERTS_PATH")
    force_new = ENV["FORCE_NEW_CERT"] == "1"

    cert(
      api_key: api_key,
      development: false,
      platform: "ios",
      force: force_new,
      keychain_path: keychain_path,
      keychain_password: keychain_password,
      output_path: certs_path
    )

    cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]
    UI.user_error!("cert_id manquant après cert") if cert_id.to_s.empty?
    UI.message("Certificat Apple ID: #{cert_id}")

    sigh(
      api_key: api_key,
      app_identifier: "com.carencescan.app",
      team_id: "4N92TKQ397",
      platform: "ios",
      skip_install: true,
      force: true,
      output_path: profiles_path,
      filename: "app.mobileprovision",
      cert_id: cert_id
    )
    UI.success("Profil app.mobileprovision — #{lane_context[SharedValues::SIGH_NAME]}")
  end

  desc "CI TestFlight — certificat + profil depuis l'API Apple"
  lane :ci_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY"),
      is_key_content_base64: false
    )

    keychain_path = ENV.fetch("KEYCHAIN_PATH")
    keychain_password = ENV.fetch("KEYCHAIN_PASSWORD")
    profiles_path = ENV.fetch("PROFILES_PATH")
    certs_path = ENV.fetch("CERTS_PATH")
    force_new = ENV["FORCE_NEW_CERT"] == "1"

    cert(
      api_key: api_key,
      development: false,
      platform: "ios",
      force: force_new,
      keychain_path: keychain_path,
      keychain_password: keychain_password,
      output_path: certs_path
    )

    cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]
    UI.user_error!("cert_id manquant après cert") if cert_id.to_s.empty?

    sigh(
      api_key: api_key,
      app_identifier: "com.carencescan.app",
      team_id: "4N92TKQ397",
      platform: "ios",
      skip_install: true,
      force: true,
      output_path: profiles_path,
      filename: "app.mobileprovision",
      cert_id: cert_id
    )
    UI.success("CI signing OK — #{lane_context[SharedValues::SIGH_NAME]}")
  end

  desc "Régénère le profil App Store lié au certificat du trousseau CI"
  lane :refresh_profiles do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY"),
      is_key_content_base64: false
    )

    keychain_path = ENV.fetch("KEYCHAIN_PATH")
    profiles_path = ENV.fetch("PROFILES_PATH")

    require "openssl"
    require "base64"

    cert_line = sh(
      "security find-identity -v -p codesigning '#{keychain_path}' 2>/dev/null | grep 'Apple Distribution' | head -1",
      log: false
    ).strip
    UI.user_error!("Apple Distribution absent du trousseau CI") if cert_line.to_s.empty?

    keychain_sha1 = cert_line.match(/\)\s+([A-F0-9]{40})\s/i)&.captures&.first
    UI.user_error!("SHA-1 keychain introuvable — ligne: #{cert_line}") unless keychain_sha1
    UI.message("SHA-1 keychain: #{keychain_sha1}")

    dist_type = Spaceship::ConnectAPI::Certificate::CertificateType::IOS_DISTRIBUTION
    api_certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: dist_type })

    cert_id = nil
    api_certs.each do |api_cert|
      der = Base64.decode64(api_cert.certificate_content)
      fingerprint = OpenSSL::Digest::SHA1.hexdigest(der).upcase
      next unless fingerprint == keychain_sha1.upcase

      cert_id = api_cert.id
      break
    end

    UI.user_error!("Certificat introuvable sur Apple Developer pour SHA-1 #{keychain_sha1}") unless cert_id
    UI.message("Certificat Apple ID (API): #{cert_id}")

    sigh(
      api_key: api_key,
      app_identifier: "com.carencescan.app",
      team_id: "4N92TKQ397",
      platform: "ios",
      adhoc: false,
      skip_install: true,
      force: true,
      output_path: profiles_path,
      filename: "app.mobileprovision",
      cert_id: cert_id
    )
    UI.success("Profil app régénéré avec cert_id #{cert_id}")
  end
end
